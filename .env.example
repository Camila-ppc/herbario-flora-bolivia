# Copia este archivo a ".env" para personalizar valores (es opcional).
# Si no existe .env, docker-compose usa los valores por defecto.

# Base de datos
DB_NAME=herbario_db
DB_USER=herbario
DB_PASSWORD=herbario123
DB_SYNC=true
SEED_DATA=true

# Gateway
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRES_IN=1h
ADMIN_USER=admin
ADMIN_PASSWORD=herbario123
CORS_ORIGINS=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX=10
